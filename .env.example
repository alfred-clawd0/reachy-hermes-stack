# reachy-hermes-stack — consolidated configuration.
# Run scripts/setup.sh, then edit .env to point at YOUR endpoints. All defaults are 127.0.0.1 placeholders;
# nothing real ships here.

# ── Body app (reachy_mini_conversation_app) ──────────────────────────────────
BACKEND_PROVIDER=local

# Transport to the brain:
#   http     — direct OpenAI-compatible /chat/completions (any agent). Simplest.
#   platform — connect to a hermes-agent gateway's reachy WebSocket (full Hermes mode).
AGENT_TRANSPORT=http

# HTTP mode: your OpenAI-compatible agent brain.
AGENT_BASE_URL=http://127.0.0.1:8642/v1
AGENT_MODEL=local-agent
# AGENT_API_KEY_ENV=API_SERVER_KEY
# API_SERVER_KEY=

# Full Hermes mode: the gateway's reachy WebSocket (served by the hermes-reachy plugin).
AGENT_PLATFORM_WS_URL=ws://127.0.0.1:8770/robot/reachy
# Absolute path required; run setup to generate and configure it.
# AGENT_PLATFORM_API_KEY_FILE=/absolute/path/to/.reachy-api-key
AGENT_PLATFORM_ROBOT_ID=reachy

# Local speech-to-text and text-to-speech (OpenAI-compatible).
AGENT_STT_BASE_URL=http://127.0.0.1:5092/v1
AGENT_QWEN_TTS_BASE_URL=http://127.0.0.1:7034/v1
AGENT_QWEN_TTS_VOICE=default

# Reachy daemon (local robot HTTP API) — playback / movement / status.
AGENT_DAEMON_BASE_URL=http://127.0.0.1:8000

# Persona: the fork ships a neutral 'local-agent' profile; bring your own via external profiles.
REACHY_MINI_CUSTOM_PROFILE=local-agent

# Stack-local gateway defaults: these do NOT enable the Hermes plugin.
# Setup prints the corresponding REACHY_* settings for the gateway's own config.
STACK_REACHY_WS_PORT=8770
STACK_REACHY_WS_HOST=127.0.0.1
STACK_REACHY_ALLOWED_ROBOTS=reachy
